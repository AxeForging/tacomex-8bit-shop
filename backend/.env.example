# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://tacomex:tacomex_secret@localhost:5432/tacomex_shop

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting (requests per time window, backed by Redis)
# Defaults: dev=10000/1000/1000, prod=100/5/10
# Uncomment and lower these values to simulate throttling during testing:
# RATE_LIMIT_GLOBAL=10   # 10 req / 15 min globally
# RATE_LIMIT_AUTH=3      # 3 login attempts / 15 min
# RATE_LIMIT_ORDERS=2    # 2 orders / 1 hour
